{
  // What this file is for: frontend/src is TypeScript, and this makes its
  // types a build gate (`npm run typecheck`). There is no emit: Node and the browser bundle
  // remove the types, so only erasable syntax is allowed (erasableSyntaxOnly),
  // type-only imports use `import type` (verbatimModuleSyntax), and an import
  // names the real file, `./x.ts` or `./x.js` (allowImportingTsExtensions).
  //
  // The service worker is frontend/sw.ts; scripts/build-js.sh writes the served
  // frontend/sw.js from it. scripts/check.sh fails on a tracked .js, .mjs or .cjs
  // file outside frontend/vendor/.
  //
  // strict is on (epic p-3cfv). Fix a strict error with a real guard; a non-null
  // `!` is only for a DOM element that is certain to exist.
  //
  // frontend/test/** is not in this checked set. tsconfig.test.json checks it
  // (and frontend/e2e/), tsconfig.scripts.json checks scripts/*.ts and
  // tsconfig.demo.json checks demo/, all with these options. The linkedom DOM
  // mismatch has one cast, in frontend/test/helpers/dom.ts; partial mocks use
  // mock<T>() from frontend/test/helpers/mock.ts.
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    // allowJs is for the vendored JS that frontend/src imports (codejar,
    // prismjs): tsc reads their types from it. It does not check them.
    "allowJs": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    // @types/node pulls in the real punycode.js, which does not typecheck.
    "maxNodeModuleJsDepth": 0,
    "skipLibCheck": true
  },
  "include": [
    "frontend/src/**/*.ts",
    "frontend/sw.ts",
    "frontend/index.html",
    "frontend/types/**/*.d.ts"
  ],
  "exclude": ["node_modules", "frontend/test"]
}
