# Docker build context exclusions.
#
# The context is the repo root (build/docker-compose.yml sets `context: ..`,
# and scripts/rebuild.sh passes `..`). build/Dockerfile copies only:
#   api/  package.json  package-lock.json  scripts/  frontend/
# Anything else here is transfer cost at best and a secret leak at worst.
#
# Do NOT exclude frontend/css/{common,light,public}/ or frontend/src/ — the
# image runs build-css.sh and build-js.sh itself and needs those sources.

# VCS and CI
.git
.gitignore
.github

# Secrets and machine-specific config
.env
.env.*
*.age

# Docs and repo furniture
docs
*.md
LICENSE
codecov.yml

# Runtime data — never belongs in an image
data
backups

# Test and coverage artifacts
coverage.out
.coverage
.coverage-thresholds.json
test_output.log
htmlcov

# Dependencies — the image runs `npm ci` from package-lock.json
node_modules

# Locally built binaries
/point
*.exe

# Editor, agent and tool caches
.beads
.claude
.doctor
.gemini
.playwright
.playwright-cli
.zed
.vscode
.idea

# The build directory itself is never copied into the image, and it holds
# build/.env plus the encrypted API key.
build
