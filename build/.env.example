# Point Engine Configuration
# Copy this file to .env and adjust values as needed

# =============================================================================
# Application
# =============================================================================
APP_NAME=TheBlog
APP_VERSION=dev
APP_ENV=development
APP_URL=
DEBUG=true

# Serve the debug frontend bundle (frontend/js-debug) instead of the minified
# release bundle. The debug bundle logs plugin mount/unmount, the plugin
# manifest and chunk loads to the browser console, and shows a "debug" badge by
# the version in the admin sidebar. Build-time gated (no runtime switch), so a
# visitor cannot enable it. Requires the debug bundle to have been built
# (scripts/build-js.sh builds it unless BUILD_DEBUG_FRONTEND=0). Off by default.
FRONTEND_DEBUG=false

# =============================================================================
# Server
# =============================================================================
HOST=0.0.0.0
PORT=8000
DEPLOY_PORT=8000

# =============================================================================
# Database
# =============================================================================
# For Docker: sqlite:/data/point.db
# For local dev: sqlite:./data/point.db
DATABASE_URL=sqlite:./data/point.db

# =============================================================================
# Storage
# =============================================================================
# For Docker: /data
# For local dev: ./data
STORAGE_PATH=./data
STORAGE_QUOTA_MB=5000
MAX_IMAGE_WIDTH=2560
JPEG_QUALITY=85
THUMBNAIL_WIDTH=180
THUMBNAIL_HEIGHT=120
AVATAR_SIZE=80
# Max request body size, MB. Enforced at the HTTP layer (413 when exceeded).
MAX_UPLOAD_SIZE_MB=50
# Size ceiling for the on-disk cache of rendered public pages
# (STORAGE_PATH/cache). Nothing else bounds it: entries are dropped wholesale by
# a content write and otherwise accumulate, one per (page, per_page) a visitor
# asks for. Past the budget, oldest entries go first. 0 disables eviction.
PAGE_CACHE_BUDGET_MB=64

# =============================================================================
# Blog Settings (defaults, can be overridden in light)
# =============================================================================
BLOG_TITLE=My Photo Blog
BLOG_SUBTITLE=A personal photography journal
AUTHOR_NAME=Photographer
AUTHOR_EMAIL=author@example.com
POSTS_PER_PAGE=10
DEFAULT_LANGUAGE=en
DEFAULT_THEME=auto

# =============================================================================
# Security
# =============================================================================
PASSWORD_MIN_LENGTH=8
SESSION_EXPIRY_HOURS=720
SESSION_EXPIRY_PUBLIC_HOURS=2

# Extra networks whose X-Forwarded-For may be believed — a comma-separated list
# of CIDR ranges, empty by default. Loopback and private networks are always
# trusted, so the usual setup (a reverse proxy on the same host or the same
# container network) needs nothing here.
#
# Set this only when the thing in front of the app answers from a PUBLIC
# address — a CDN pointed straight at the container, a cloud load balancer,
# a bastion. Otherwise every visitor arriving through one edge is recorded as
# that edge: they share a single rate-limit bucket (including the login
# limiter), and the session list in Admin → Security shows the edge address
# instead of the person who logged in. Paste your provider's published ranges.
#
# This is a trust boundary, and a too-wide value is the whole risk: any peer
# inside these ranges can claim to be any client. TRUSTED_PROXIES=0.0.0.0/0
# trusts everybody and makes the client IP entirely client-controlled. A single
# address needs a prefix (203.0.113.7/32); a malformed entry stops the server
# at startup rather than being skipped.
TRUSTED_PROXIES=

# =============================================================================
# Features
# =============================================================================
GOOGLE_ANALYTICS_ID=
FORCE_HTTPS=false
SHOW_VIEW_COUNTS=true

# =============================================================================
# Media Import
# =============================================================================
# Path to a local directory that Point will scan for photos to import.
# Overrides the value set in Settings → Photo Library path.
PHOTO_LIBRARY_PATH=

# =============================================================================
# MCP server (the "mcp" plugin, served at /mcp)
# =============================================================================
# Exposes the blog to AI clients over the Model Context Protocol. The plugin is
# OFF by default — enable it from the admin Plugins page. The endpoint accepts
# either a point API key / session, or an OAuth 2.1 bearer token. Programmatic
# clients should use a point API key (admin → API Keys). Interactive OAuth login
# uses your admin password.
#
# Public HTTPS base URL advertised in OAuth discovery metadata. Falls back to
# APP_URL when empty.
MCP_BASE_URL=

# =============================================================================
# Comments (the "comments" plugin, remark42 at /comments)
# =============================================================================
# The image bundles the remark42 comment engine as a loopback-only sidecar. It
# starts only when BOTH values below are set; without them the blog runs
# unaffected. Enable the plugin from the admin Plugins page to show the widget
# under public posts; moderation lives at /light/comments (Admin → Comments).
#
# Public URL of the comments endpoint: your blog's public URL + /comments.
REMARK_URL=
# remark42 JWT-signing secret — any long random string (openssl rand -hex 32).
REMARK_SECRET=
# Anonymous commenting (default true). Set false to require OAuth logins,
# configured via remark42 AUTH_* vars — https://remark42.com/docs/
AUTH_ANON=true
# Upgrades: remark42 ships inside the image (rebuild with --pull picks up the
# latest release; pin with the REMARK42_VERSION build arg if one breaks).

# =============================================================================
# Email (SMTP) — password reset + comment email login
# =============================================================================
# Point sends all email over plain SMTP, so any provider with an SMTP relay
# works — Mailgun, Brevo, SendGrid, Amazon SES — or your own private SMTP
# server. Port 465 uses implicit TLS, 587 uses STARTTLS (chosen automatically).
#
# Provider examples:
#   Mailgun:      SMTP_HOST=smtp.mailgun.org      SMTP_PORT=587  (user: postmaster@your-domain)
#   Brevo (free): SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587
#   SendGrid:     SMTP_HOST=smtp.sendgrid.net     SMTP_PORT=587  (user is literally "apikey")
#   Amazon SES:   SMTP_HOST=email-smtp.<region>.amazonaws.com  SMTP_PORT=587
#   Self-hosted:  SMTP_HOST=mail.your-domain.com  SMTP_PORT=587 or 465
#
# Used for:
# - Password reset emails (also requires APP_URL above, to build the link).
# - Comment email login (remark42): enable "email login" in Admin → Settings →
#   Comments; it reuses this SMTP config unless you set a separate SMTP host
#   there.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Sender address shown in emails; defaults to SMTP_USERNAME when empty.
SMTP_FROM=

# =============================================================================
# Backup
# =============================================================================
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=2
