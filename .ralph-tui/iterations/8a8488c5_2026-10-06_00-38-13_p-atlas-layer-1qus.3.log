  /** Clear the inline styles a swipe left on the mount, before the grid remounts. */
  resetGridStyles() {
    const gm = this._o.gridMount();
    if (!gm) return;
    gm.style.transform = '';
    gm.style.opacity = '';
    gm.style.transition = '';
