# Environments
.env
.env.*
# …but the template is meant to be read. A negation only works after the pattern
# that ignored the file, so keep this line below `.env.*`.
!.env.example

# Agent instructions ship with this repo. Many developers ignore these names
# globally (~/.gitignore_global); patterns here take precedence over that file,
# which is what keeps AGENTS.md tracked for everyone who clones.
!AGENTS.md
!CLAUDE.md
# Maintainer-only overrides stay local.
CLAUDE.local.md
GEMINI.md

# IDE
*~

# Docker
docker-compose.override.yml

# Secrets (never commit these!)
*.pem
*.key
*.crt
secrets/
credentials.json

# Deployment & Generated artifacts
deployment-*.log
api/coverage.html
coverage-frontend.lcov
api/api*
# Binaries a bare `go build` drops in api/ (run.sh builds to ./point instead)
api/point
api/migrate-paths
api/cmd/api/cache/
*.out

# Frontend generated files
frontend/js/
frontend/js-debug/
# esbuild metafiles — build intermediates, kept out of the served frontend/js
.build-meta/
frontend/css/main.css
frontend/css/light.css
frontend/css/viewer.css
frontend/css/asset-manifest.json
frontend/css/common/theme.css
frontend/css/p/

# Static UI demo (demo/scripts/build.sh) — build output.
demo/dist/
# Throwaway instance used to generate demo content (demo/scripts/make-content.sh).
demo/.scratch/
# Transcoded demo media, reused across builds (demo/scripts/build.sh).
demo/.media-cache/
# Recorded demo fixtures. Regenerate with demo/scripts/record-fixtures.mjs
# against an instance whose content you intend to publish: the recording is a
# copy of that instance's posts, tags and media metadata.
demo/mock/fixtures/fixtures.json

# bv (beads viewer) local config and caches
.bv/
.worktrees/
# br doctor per-run artifacts
.doctor/
*.bak
