# Local development overrides for ./scripts/run.sh
#
# You do not need this file. `./scripts/run.sh` runs a fresh clone with no
# configuration at all: it defaults the database to data/point.db, storage to
# data/, and the bind address to 127.0.0.1:8001.
#
# Copy it to .env only when you want one of the optional integrations below.
# The full configuration reference — every variable the server reads, with the
# values a container deployment wants — is build/.env.example.

# ── Server ───────────────────────────────────────────────────────────────────
# Bind address for the dev server. Unset means 127.0.0.1 (loopback only).
# Set 0.0.0.0 to reach the dev server from your phone or another machine.
#LOCAL_RUN=0.0.0.0

# ── Optional: AI photo analysis ──────────────────────────────────────────────
# Enables Gemini-suggested titles, tags and descriptions on upload.
# Without a key the feature is simply absent. See docs/features/ai-analysis.md.
#GEMINI_API_KEY=

# ── Optional: import from a local photo library ──────────────────────────────
# Directory the server may browse and import from. Also the sandbox root for the
# MCP point_upload_media tool, which refuses to read outside it and fails closed
# when this is unset. See docs/features/media.md.
#PHOTO_LIBRARY_PATH=/home/you/Pictures

# ── Optional: comments (remark42) ────────────────────────────────────────────
# Locally remark42 runs as a sidecar container on 127.0.0.1:8081, started by
# scripts/run.sh when all three are set. See docs/features/comments.md.
#REMARK_URL=http://127.0.0.1:8081
#REMARK_SECRET=
#ADMIN_PASSWD=

# ── Optional: email (password reset) ─────────────────────────────────────────
# See docs/features/auth.md. Without SMTP_HOST, sending a reset email fails with
# "SMTP not configured" — recover offline with `./point reset-password ...`.
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USERNAME=
#SMTP_PASSWORD=
#SMTP_FROM=

# ── Optional: off-host backup copy ──────────────────────────────────────────
# Backups land in data/backups — on the same disk they protect. Set a command
# to ship each finished archive off-host; its path is $POINT_BACKUP_FILE (also
# $1). Failures surface as a "backup off-host copy" job in Admin → Health. See
# the "Off-host copy" section of docs/plugins/backups.md.
#BACKUP_HOOK=rclone copy "$POINT_BACKUP_FILE" r2:my-bucket/point-backups/
#BACKUP_HOOK_TIMEOUT_SECONDS=3600
