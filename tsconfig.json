{
  // What this file is for: frontend/src is TypeScript, and this makes its
  // types a build gate (`npm run typecheck`). There is no emit: Node and the browser bundle
  // remove the types, so only erasable syntax is allowed (erasableSyntaxOnly),
  // type-only imports use `import type` (verbatimModuleSyntax), and an import
  // names the real file, `./x.ts` or `./x.js` (allowImportingTsExtensions).
  //
  // allowJs and checkJs stay on for frontend/sw.js, the one checked JS file.
  // scripts/check.sh fails on a .js file under frontend/src.
  //
  // strict stays off deliberately: turning it on adds null-safety errors to
  // every DOM read at once, which is a separate piece of work.
  //
  // frontend/test/** is deliberately NOT in the checked set. Checking it once
  // cost 401 errors across 70 files, and a file-by-file audit of them found
  // exactly one real defect: linkedom's DOM is not the DOM lib's DOM, mocks are
  // partial objects on purpose, and tests attach their own tracker properties
  // to instances. The value of this gate is enforcing the types in src/, and
  // the src/ types a test exercises are checked from src/ either way. An honest
  // exclusion beats 70 @ts-nocheck pragmas nobody intends to remove.
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "strict": false,
    // @types/node pulls in the real punycode.js, which does not typecheck.
    "maxNodeModuleJsDepth": 0,
    "skipLibCheck": true
  },
  "include": [
    "frontend/src/**/*.ts",
    "frontend/*.js",
    "frontend/index.html",
    "frontend/types/**/*.d.ts"
  ],
  "exclude": ["node_modules", "frontend/test"]
}
